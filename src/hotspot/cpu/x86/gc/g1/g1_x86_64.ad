//
// G1 disaggregated-memory C2 load barrier for x86-64.
//
// Intercepts every oop load/atomic that carries barrier_data != 0
// (set by G1BarrierSetC2::load_at_resolved / atomic overrides).
// After the load, tagged oops jump to an out-of-line resolver stub. In
// remote mode, clean non-null oops also jump there because they can be stale
// pre-eviction addresses into guarded regions.
//
// The stub saves/restores all call-clobbered registers so the resolved
// oop is transparent to the rest of the compiled code.
//

source_hpp %{

#include "gc/shared/gc_globals.hpp"
#include "gc/g1/c2/g1BarrierSetC2.hpp"
#include "gc/g1/g1BarrierSetRuntime.hpp"
#include "opto/compile.hpp"
#include "opto/output.hpp"

%}

source %{

#include "gc/g1/c2/g1BarrierSetC2.hpp"
#include "gc/g1/g1BarrierSetRuntime.hpp"

// Emit the inline sign-bit test + jump to out-of-line stub.
// Called from every g1Load / g1CompareAndExchange / g1GetAndSet
// instruction after the actual memory operation.
static void g1_tag_resolve_barrier(MacroAssembler& _masm,
                                   const MachNode* node,
                                   Address ref_addr,
                                   Register ref) {
  if (node->barrier_data() == 0) return;

  __ testptr(ref, ref);

  // Create out-of-line stub (registered with G1BarrierSetC2State)
  G1TagResolveStubC2* const stub =
      new (Compile::current()->comp_arena()) G1TagResolveStubC2(node, ref_addr, ref);
  if (!Compile::current()->output()->in_scratch_emit_size()) {
    G1BarrierSetC2State* bs_state =
        reinterpret_cast<G1BarrierSetC2State*>(Compile::current()->barrier_set_state());
    bs_state->stubs()->append(stub);
  }

  if (UseRemoteExecutor || LocalMemoryRatio < 100 || G1TagRefSites ||
      G1SimulateRemoteEviction || G1RemoteEvictionThreshold > 0) {
    __ jcc(Assembler::notZero, *stub->entry());
  } else {
    __ jcc(Assembler::negative, *stub->entry());
  }

  // Continuation: oop is now resolved (either was untagged, or stub resolved it)
  __ bind(*stub->continuation());
}

%}

// ============================================================
// Load Pointer with G1 tag-resolve barrier
// ============================================================
instruct g1LoadP(rRegP dst, memory mem, rFlagsReg cr)
%{
  predicate(UseG1GC && n->as_Load()->barrier_data() != 0);
  match(Set dst (LoadP mem));
  effect(TEMP dst, KILL cr);

  ins_cost(125);

  format %{ "movq     $dst, $mem\t# ptr (G1 tag-resolve barrier)" %}

  ins_encode %{
    __ movq($dst$$Register, $mem$$Address);
    g1_tag_resolve_barrier(_masm, this, $mem$$Address, $dst$$Register);
  %}

  ins_pipe(ialu_reg_mem);
%}

// ============================================================
// CompareAndExchangeP with G1 tag-resolve barrier on result
// ============================================================
// The result of cmpxchg is the old value read from memory, which
// may be a tagged oop if another thread stored one.  We resolve
// the tag on the returned old value.
instruct g1CompareAndExchangeP(
                         memory mem_ptr,
                         rax_RegP oldval, rRegP newval,
                         rRegP expected_tmp, rRegP tagged_tmp,
                         rFlagsReg cr)
%{
  predicate(UseG1GC && VM_Version::supports_cx8() && n->as_LoadStore()->barrier_data() != 0);
  match(Set oldval (CompareAndExchangeP mem_ptr (Binary oldval newval)));
  effect(TEMP expected_tmp, TEMP tagged_tmp, KILL cr);

  format %{ "lock\n\t"
            "cmpxchgq $newval, $mem_ptr\t# (G1 logical tagged compare-and-exchange)" %}

  ins_encode %{
    Label done, not_tagged_or_mismatch, retry_failed;
    __ movptr($expected_tmp$$Register, $oldval$$Register);
    __ lock();
    __ cmpxchgq($newval$$Register, $mem_ptr$$Address);
    __ jcc(Assembler::equal, done);

    // If the raw memory value is tagged but resolves to the clean expected
    // oop, the Java-level compare should succeed. Retry atomically using the
    // raw tagged bits as the hardware compare value.
    __ movptr($tagged_tmp$$Register, $oldval$$Register);
    g1_tag_resolve_barrier(_masm, this, $mem_ptr$$Address, $oldval$$Register);
    __ cmpptr($oldval$$Register, $expected_tmp$$Register);
    __ jcc(Assembler::notEqual, not_tagged_or_mismatch);
    __ movptr($oldval$$Register, $tagged_tmp$$Register);
    __ lock();
    __ cmpxchgq($newval$$Register, $mem_ptr$$Address);
    __ jcc(Assembler::notEqual, retry_failed);
    __ movptr($oldval$$Register, $expected_tmp$$Register);
    __ jmp(done);

    __ bind(retry_failed);
    g1_tag_resolve_barrier(_masm, this, $mem_ptr$$Address, $oldval$$Register);
    __ jmp(done);

    __ bind(not_tagged_or_mismatch);
    __ bind(done);
  %}

  ins_pipe(pipe_cmpxchg);
%}

// ============================================================
// CompareAndSwapP with G1 tag-resolve barrier
// ============================================================
// CAS returns a boolean (success/fail), not the old oop, so we
// do NOT need to resolve the result.  But we still need to match
// this instruction when barrier_data != 0 so the default
// (barrier_data == 0) rule does not fire.
instruct g1CompareAndSwapP(rRegI res,
                           memory mem_ptr,
                           rRegP expected_tmp, rRegP tagged_tmp,
                           rRegP newval, rFlagsReg cr,
                           rax_RegP oldval)
%{
  predicate(UseG1GC && VM_Version::supports_cx8() && n->as_LoadStore()->barrier_data() != 0);
  match(Set res (CompareAndSwapP mem_ptr (Binary oldval newval)));
  match(Set res (WeakCompareAndSwapP mem_ptr (Binary oldval newval)));
  effect(TEMP expected_tmp, TEMP tagged_tmp, KILL cr, KILL oldval);

  format %{ "lock\n\t"
            "cmpxchgq $newval, $mem_ptr\n\t"
            "sete     $res\n\t"
            "movzbl   $res, $res\t# (G1 logical tagged compare-and-swap)" %}

  ins_encode %{
    Label success, fail, done;
    __ movptr($expected_tmp$$Register, $oldval$$Register);
    __ lock();
    __ cmpxchgq($newval$$Register, $mem_ptr$$Address);
    __ jcc(Assembler::equal, success);

    // Normal Java loads resolve tagged handles before exposing values to the
    // program.  Unsafe CAS must therefore treat a tagged field value and its
    // resolved clean oop as equal, then retry with the raw tagged compare bits.
    __ movptr($tagged_tmp$$Register, $oldval$$Register);
    g1_tag_resolve_barrier(_masm, this, $mem_ptr$$Address, $oldval$$Register);
    __ cmpptr($oldval$$Register, $expected_tmp$$Register);
    __ jcc(Assembler::notEqual, fail);
    __ movptr($oldval$$Register, $tagged_tmp$$Register);
    __ lock();
    __ cmpxchgq($newval$$Register, $mem_ptr$$Address);
    __ jcc(Assembler::equal, success);

    __ bind(fail);
    __ xorl($res$$Register, $res$$Register);
    __ jmp(done);

    __ bind(success);
    __ movl($res$$Register, 1);
    __ bind(done);
    __ movzbl($res$$Register, $res$$Register);
  %}

  ins_pipe(pipe_cmpxchg);
%}

// ============================================================
// GetAndSetP (xchg) with G1 tag-resolve barrier
// ============================================================
// xchg atomically swaps newval into memory and returns the old value.
// The old value may be tagged, so we resolve it.
instruct g1GetAndSetP(memory mem, rRegP newval, rFlagsReg cr) %{
  predicate(UseG1GC && n->as_LoadStore()->barrier_data() != 0);
  match(Set newval (GetAndSetP mem newval));
  effect(KILL cr);

  format %{ "xchgq    $newval, $mem\t# (G1 tag-resolve barrier on old value)" %}

  ins_encode %{
    __ xchgq($newval$$Register, $mem$$Address);
    g1_tag_resolve_barrier(_masm, this, $mem$$Address, $newval$$Register);
  %}

  ins_pipe(pipe_cmpxchg);
%}
